{
  "name": "Client intake · Cal.com booking → same client row",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "client-intake-booking",
        "options": {
          "noResponseBody": true
        }
      },
      "id": "03722a95-3c20-4b3b-9c68-454984f54507",
      "name": "Cal.com Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "61b6468f-f500-49c8-92aa-7e8286c28311"
    },
    {
      "parameters": {
        "jsCode": "const map = { BOOKING_CREATED: 'заброньовано', BOOKING_RESCHEDULED: 'перенесено', BOOKING_CANCELLED: 'скасовано' };\nconst out = [];\nfor (const item of $input.all()) {\n  const b = item.json.body || {};\n  const p = b.payload || {};\n  const a = (p.attendees || [])[0] || {};\n  // ignore PING and any other events, and payloads without an attendee e-mail\n  if (!map[b.triggerEvent] || !a.email) continue;\n  out.push({ json: {\n    email: a.email,\n    name: a.name || '',\n    booking_start: p.startTime || null,\n    booking_status: map[b.triggerEvent],\n    booking_meet_url: (p.metadata && p.metadata.videoCallUrl) || (p.videoCallData && p.videoCallData.url) || p.location || '',\n    booking_uid: p.uid || '',\n  } });\n}\nreturn out;"
      },
      "id": "6fe227a5-31b2-4ba1-b5d6-5b1d9702ceb0",
      "name": "Normalize Booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID",
          "cachedResultName": "client_briefs"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "keyValue": "={{ $json.email }}"
            }
          ]
        },
